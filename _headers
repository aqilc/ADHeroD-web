# no-transform keeps Cloudflare from injecting its bot-check and analytics scripts, so the CS exe's bundle
# download hashes the pages as deployed. Rules match the path after the .html redirect (/index.html → /).
# ceiling: no-transform also skips compression, index.html goes out 257 KB instead of 61 KB br; revisit if a cold load
# after a deploy feels slow on his phone, by turning off Bot Fight Mode and Web Analytics' auto-inject instead.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
